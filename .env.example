# Default/primary setup: EPC_SCOT_API_BASE_UR
# Add:
EPC_SCOT_API_BASE_URL=https://api.epcdata.scot
EPC_SCOT_API_USERNAME=
EPC_SCOT_API_PASSWORD=

# Optional: better address lookup via OS Places Find API
OS_PLACES_API_KEY=

# Optional: override SPEN heatmap endpoint
SPEN_HEATMAP_API_URL=

# Vercel setup:
# 1) Copy these values into Vercel > Project > Settings > Environment Variables
# 2) Save for Production (and Preview if needed)
# 3) Redeploy the project
