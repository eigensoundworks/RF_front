# Required for live EPC Open Data lookup
EPC_REGISTER_API_KEY=
EPC_REGISTER_EMAIL=

# Optional: override static EPC blob source (defaults to built-in public blob)
EPC_BLOB_URL=

# Optional: better address lookup via OS Places Find API
OS_PLACES_API_KEY=

# Optional: live DNO/SSEN headroom overlay endpoint (+ optional auth key)
DNO_API_URL=
DNO_API_KEY=

# Optional: override SPEN heatmap endpoint
SPEN_HEATMAP_API_URL=

# Vercel setup:
# 1) Copy these values into Vercel > Project > Settings > Environment Variables
# 2) Save for Production (and Preview if needed)
# 3) Redeploy the project
